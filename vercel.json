{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "version": 2,
    "regions": [
        "iad1",
        "cdg1",
        "sin1",
        "gru1"
    ],
    "functions": {
        "src/app/api/checkout/route.ts": {
            "maxDuration": 30
        },
        "src/app/api/webhooks/stripe/route.ts": {
            "maxDuration": 30
        },
        "src/app/api/inngest/route.ts": {
            "maxDuration": 300
        }
    },
    "headers": [
        {
            "source": "/(.*)",
            "headers": [
                {
                    "key": "X-Content-Type-Options",
                    "value": "nosniff"
                },
                {
                    "key": "X-Frame-Options",
                    "value": "DENY"
                },
                {
                    "key": "Referrer-Policy",
                    "value": "strict-origin-when-cross-origin"
                }
            ]
        }
    ]
}